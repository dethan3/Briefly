{
  "manifest_version": 3,
  "name": "Briefly — YouTube Transcript Reader",
  "version": "0.1.0",
  "description": "Turn existing YouTube captions into a clean, searchable, timestamped transcript.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core.js", "youtube.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
